{
  "name": "@ds/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx src/api.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "backup:now": "node --env-file-if-exists=.env --import tsx src/backup-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@date-fns/tz": "^1.5.0",
    "@ds/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "pino": "^10.3.1",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  }
}
