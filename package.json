{
  "name": "guitar-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "docker compose -f compose.dev.yml up -d --wait && pnpm db:migrate && pnpm --parallel --filter './apps/*' run \"/^dev/\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ds/server db:generate",
    "db:migrate": "pnpm --filter @ds/server db:migrate",
    "build": "pnpm --filter @ds/web build && pnpm --filter @ds/server build",
    "backup:now": "pnpm --filter @ds/server backup:now",
    "e2e": "pnpm --filter @ds/web build && pnpm --filter @ds/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
