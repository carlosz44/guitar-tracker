NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_URL=http://localhost:5173
DATABASE_URL=postgres://guitartracker:guitartracker@localhost:5433/guitartracker
TEST_DATABASE_URL=postgres://guitartracker:guitartracker@localhost:5433/guitartracker_test

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Development GitHub OAuth app (callback http://localhost:5173/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_IDS=

R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET=guitar-tracker
# Only for an EU-jurisdiction bucket or a local S3-compatible server.
# R2_ENDPOINT=

DEFAULT_TIMEZONE=America/Lima

# Claude (005). Without a key the app runs and the Claude buttons are hidden.
ANTHROPIC_API_KEY=
# LLM_MODEL_DEFAULT=claude-sonnet-5-5
# LLM_MONTHLY_BUDGET_USD=10
